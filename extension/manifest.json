{
  "manifest_version": 3,
  "name": "ORION — Intent Feed Filter",
  "version": "2.1.1",
  "description": "Removes off-intent posts from your X/Twitter feed using a goal + prompt and explicit blocklists. All scoring runs locally.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ORION"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-adapter.js", "content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    }
  ]
}