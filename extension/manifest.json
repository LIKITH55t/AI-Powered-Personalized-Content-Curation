{
  "manifest_version": 3,
  "name": "ORION Goal-Based Feed",
  "version": "1.0.0",
  "description": "Hide off-intent posts using natural-language goals.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ORION"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:5173/*", "http://localhost:5173/*", "file://*/*"],
      "js": ["content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["x-adapter.js", "content.js"],
      "css": ["hide.css"],
      "run_at": "document_idle"
    }
  ]
}
